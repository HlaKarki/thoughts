#!/bin/zsh
setopt err_exit pipe_fail no_unset

repo=${0:A:h:h}
cd $repo

release=$repo/build/release
logs=$release/logs
updates=$release/updates
archive=$release/Thoughts.xcarchive
app=$release/export/Thoughts.app
generate_appcast=$repo/build/SourcePackages/artifacts/sparkle/Sparkle/bin/generate_appcast
notary_profile=thoughts-notary
github_repo=HlaKarki/thoughts
tap_name=hlakarki/tap
current=setup

usage() {
  print -u2 "usage: scripts/release [--dry-run] <version>"
  exit 2
}

fail() {
  print -u2 "release: step $current: $*"
  exit 1
}

TRAPZERR() {
  print -u2 "release: step $current stopped on a failed command"
}

step() {
  current="$1/10"
  print "\n[$1/10] $2"
}

run_logged() {
  local name=$1
  shift
  local log=$logs/$name.log
  if ! "$@" >$log 2>&1; then
    tail -n 40 $log >&2
    fail "$name failed, the full log is $log"
  fi
}

format_check() {
  git ls-files -z --cached --others --exclude-standard '*.swift' | xargs -0 xcrun swift-format lint --strict
}

check_signature() {
  local target=$1
  local details
  details=$(codesign -dvv $target 2>&1) || fail "codesign can't read ${target#$release/}"
  local identifier=${${(M)${(f)details}:#Identifier=*}#Identifier=}
  local flags=${${(M)${(f)details}:#CodeDirectory*}##*flags=}
  print "  ${target#$release/export/}: $identifier ${flags%% *}"
  [[ $details != *"Signature=adhoc"* ]] || fail "${target#$release/} is signed ad hoc"
  [[ $details == *"Authority=Developer ID Application:"* ]] || fail "${target#$release/} is not signed with Developer ID"
  [[ $details == *"Timestamp="* ]] || fail "${target#$release/} has no secure timestamp"
  [[ $flags == *runtime* ]] || fail "${target#$release/} is not signed with the hardened runtime"
}

check_signatures() {
  local nested=(
    ${(f)"$(find $app/Contents -depth -type d \( -name '*.app' -o -name '*.appex' -o -name '*.xpc' -o -name '*.framework' \))"}
    $app/Contents/Frameworks/*.framework/Versions/*/Autoupdate(N)
    $app/Contents/Helpers/*(N)
  )
  local target
  for target in $nested $app; do
    check_signature $target
  done
  codesign --verify --deep --strict $app || fail "codesign --verify --deep --strict rejected the app"
}

write_cask() {
  cat <<CASK
cask "thoughts" do
  version "$version"
  sha256 "$sha256"

  url "https://github.com/HlaKarki/thoughts/releases/download/v#{version}/Thoughts-#{version}.zip"
  name "Thoughts"
  desc "Save text and screenshots from any app as Markdown files"
  homepage "https://thoughts.hla.dev"

  auto_updates true
  depends_on macos: ">= :sequoia"

  app "Thoughts.app"
  binary "#{appdir}/Thoughts.app/Contents/Helpers/thoughts"

  zap trash: [
    "~/Library/Application Support/Thoughts",
    "~/Library/Caches/dev.hla.thoughts",
    "~/Library/Containers/dev.hla.thoughts.share",
    "~/Library/Group Containers/*.dev.hla.thoughts",
    "~/Library/HTTPStorages/dev.hla.thoughts",
    "~/Library/Preferences/dev.hla.thoughts.plist",
  ]
end
CASK
}

dry_run=false
if [[ ${1-} == --dry-run ]]; then
  dry_run=true
  shift
fi
(( $# == 1 )) || usage
version=$1
tag=v$version

step 1 "Checking the tree, the version and the tag"
[[ $version =~ '^[0-9]{4}\.[0-9]{1,2}\.[0-9]+$' ]] || fail "$version is not a version like 2026.12.1"
[[ -z $(git status --porcelain) ]] || fail "the tree has uncommitted or untracked changes"
branch=$(git branch --show-current)
if $dry_run; then
  print "Dry run, so the branch check is skipped (on ${branch:-a detached HEAD})"
elif [[ $branch != main ]]; then
  fail "releases come from main, not ${branch:-a detached HEAD}"
fi
if git rev-parse -q --verify refs/tags/$tag >/dev/null; then
  fail "tag $tag already exists"
fi
[[ -f Config/Local.xcconfig ]] || fail "Config/Local.xcconfig is missing, so copy Config/Local.xcconfig.example and set DEVELOPMENT_TEAM"
team=$(sed -n -E 's/^[[:space:]]*DEVELOPMENT_TEAM[[:space:]]*=[[:space:]]*([A-Z0-9]{10})[[:space:]]*$/\1/p' Config/Local.xcconfig | tail -n 1)
[[ -n $team ]] || fail "Config/Local.xcconfig has no DEVELOPMENT_TEAM"
if ! $dry_run; then
  remote_code=0
  git ls-remote --exit-code --tags origin refs/tags/$tag >/dev/null || remote_code=$?
  case $remote_code in
    0) fail "tag $tag already exists on origin" ;;
    2) ;;
    *) fail "git ls-remote origin failed" ;;
  esac
  gh auth status >/dev/null 2>&1 || fail "gh is not signed in"
  author_name=$(git config user.name) || fail "git user.name is not set"
  author_email=$(git config user.email) || fail "git user.email is not set"
  tap=$(brew --repository $tap_name)
  [[ -d $tap/.git ]] || fail "$tap_name is not tapped, so run brew tap $tap_name first"
  [[ -z $(git -C $tap status --porcelain) ]] || fail "the tap at $tap has uncommitted changes"
fi
build_number=$(git rev-list --count HEAD)
print "Version $version, build $build_number, tag $tag"
rm -rf $release
mkdir -p $logs $updates

step 2 "Running the comment check, the format check and the core tests"
run_logged comment-check swift run --package-path Tools/CommentCheck --only-use-versions-from-resolved-file comment-check .
run_logged format-check format_check
run_logged core-tests swift test --package-path Packages/ThoughtsCore --only-use-versions-from-resolved-file
print "All three passed"

step 3 "Archiving Release $version ($build_number)"
run_logged xcodegen xcodegen generate
[[ -z $(git status --porcelain) ]] || fail "xcodegen changed tracked files, so regenerate and commit them first"
mkdir -p Thoughts.xcodeproj/project.xcworkspace/xcshareddata/swiftpm
cp Config/Package.resolved Thoughts.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
run_logged archive xcodebuild -project Thoughts.xcodeproj -scheme Thoughts -configuration Release \
  -archivePath $archive -derivedDataPath build/DerivedData -clonedSourcePackagesDirPath build/SourcePackages \
  -onlyUsePackageVersionsFromResolvedFile \
  MARKETING_VERSION=$version CURRENT_PROJECT_VERSION=$build_number archive
archived_plist=$archive/Products/Applications/Thoughts.app/Contents/Info.plist
[[ $(plutil -extract CFBundleShortVersionString raw -o - $archived_plist) == $version ]] || fail "the archived app is not version $version"
[[ $(plutil -extract CFBundleVersion raw -o - $archived_plist) == $build_number ]] || fail "the archived app is not build $build_number"
[[ -x $generate_appcast ]] || fail "Sparkle's generate_appcast is not at ${generate_appcast#$repo/}"
print "Archived to ${archive#$repo/}"

step 4 "Exporting with Developer ID"
cp Config/ExportOptions.plist $release/ExportOptions.plist
plutil -replace teamID -string $team $release/ExportOptions.plist
run_logged export xcodebuild -exportArchive -archivePath $archive -exportPath $release/export \
  -exportOptionsPlist $release/ExportOptions.plist
[[ -d $app ]] || fail "the export has no Thoughts.app"
check_signatures
print "Every signature is Developer ID with the hardened runtime and a timestamp"

step 5 "Notarizing and stapling"
mkdir -p $release/notarize
ditto -c -k --keepParent $app $release/notarize/Thoughts.zip
xcrun notarytool submit $release/notarize/Thoughts.zip --keychain-profile $notary_profile --wait \
  --output-format plist >$release/notarize/submission.plist || fail "notarytool submit failed"
submission=$(plutil -extract id raw -o - $release/notarize/submission.plist)
notary_status=$(plutil -extract status raw -o - $release/notarize/submission.plist)
xcrun notarytool log $submission --keychain-profile $notary_profile $release/notarize/log.json >/dev/null
print "Submission $submission: $notary_status"
if [[ $notary_status != Accepted ]]; then
  cat $release/notarize/log.json >&2
  fail "notarization returned $notary_status"
fi
run_logged staple xcrun stapler staple $app
xcrun stapler validate $app || fail "the staple does not validate"
zip=$updates/Thoughts-$version.zip
ditto -c -k --keepParent $app $zip

step 6 "Checking Gatekeeper"
assessment=$(spctl -a -t exec -vv $app 2>&1) || fail "spctl rejected the app: $assessment"
print -r -- $assessment
[[ $assessment == *"source=Notarized Developer ID"* ]] || fail "spctl does not report source=Notarized Developer ID"

step 7 "Writing the appcast and the cask"
run_logged appcast $generate_appcast --download-url-prefix "https://github.com/$github_repo/releases/download/$tag/" \
  -o $updates/appcast.xml $updates
[[ -f $updates/appcast.xml ]] || fail "generate_appcast wrote no appcast.xml"
sha256=$(shasum -a 256 $zip | cut -d ' ' -f 1)
write_cask >$release/thoughts.rb
print "Wrote ${updates#$repo/}/appcast.xml and build/release/thoughts.rb (sha256 $sha256)"

step 8 "Stopping for a dry run"
if $dry_run; then
  print "Dry run finished. The stapled app, ${zip#$repo/}, the appcast and the cask are in build/release."
  exit 0
fi
print "Not a dry run, so publishing $tag"

step 9 "Tagging and publishing the GitHub release"
git tag $tag
git push origin refs/tags/$tag
gh release create $tag $zip $updates/appcast.xml --repo $github_repo --verify-tag \
  --title "Thoughts $version" --generate-notes

step 10 "Updating the cask in $tap_name"
git -C $tap pull --ff-only
cask=$tap/Casks/thoughts.rb
if [[ -f $cask ]]; then
  sed -i '' -E "s/^  version \".*\"$/  version \"$version\"/; s/^  sha256 \".*\"$/  sha256 \"$sha256\"/" $cask
  grep -q "^  version \"$version\"$" $cask || fail "the cask's version line was not rewritten"
  grep -q "^  sha256 \"$sha256\"$" $cask || fail "the cask's sha256 line was not rewritten"
else
  mkdir -p $tap/Casks
  cp $release/thoughts.rb $cask
fi
brew audit --cask --online $tap_name/thoughts
git -C $tap add Casks/thoughts.rb
git -C $tap -c user.name=$author_name -c user.email=$author_email commit -m "chore: thoughts; $version"
git -C $tap push
print "Released Thoughts $version"
